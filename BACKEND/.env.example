# ==============================================================================
# PolicyLens Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
API_PORT=8000
DEBUG=True

# Database Configuration
# Default is SQLite for instant local zero-dependency operation.
# For production PostgreSQL with pgvector, uncomment the line below:
DATABASE_URL=sqlite:///./policylens.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/policylens_db

# Security & JWT Authentication
JWT_SECRET=policylens_super_secure_jwt_secret_key_2026_health_rag
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Storage
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=30

# LLM Grounded Answer Generation & Real-Time Streaming
# Supported providers: 'auto' (detects available key or local model), 'groq', 'gemini', 'openai', 'openrouter', 'ollama', 'llama_cpp'
LLM_PROVIDER=auto
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Indexing & Retrieval Mode
# Set to false for instant (< 3s) BM25 + sublinear TF-IDF cosine indexing without heavy CPU PyTorch loading.
# Set to true only if GPU/neural embeddings are desired.
USE_NEURAL_EMBEDDINGS=false
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FALLBACK_EMBEDDING_MODEL=BAAI/bge-m3
CLASSIFIER_MODEL_NAME=microsoft/deberta-v3-base
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hybrid Retrieval Configurable Weights (alpha + beta + gamma = 1.0)
HYBRID_ALPHA=0.50     # Dense semantic score weight
HYBRID_BETA=0.35      # Sparse BM25 keyword score weight
HYBRID_GAMMA=0.15     # Clause-category signal boost weight
TOP_K_RETRIEVAL=12

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000
