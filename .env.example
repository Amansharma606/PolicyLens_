# ==============================================================================
# PolicyLens Environment Configuration Example
# ==============================================================================

# Backend API Configuration
# Copy this file to BACKEND/.env for local backend development
ENVIRONMENT=development
API_PORT=8000
DEBUG=True

# Database Configuration (Default is SQLite)
DATABASE_URL=sqlite:///./policylens.db

# Security & JWT Authentication
JWT_SECRET=policylens_super_secure_jwt_secret_key_2026_health_rag
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Storage
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=30

# LLM Grounded Answer Generation
# Supported options: 'gemini', 'openai', 'ollama', 'mock_local'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding & Classification Models
EMBEDDING_MODEL_NAME=BAAI/bge-m3
FALLBACK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLASSIFIER_MODEL_NAME=microsoft/deberta-v3-base
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hybrid Retrieval Configurable Weights (alpha + beta + gamma = 1.0)
HYBRID_ALPHA=0.50
HYBRID_BETA=0.35
HYBRID_GAMMA=0.15
TOP_K_RETRIEVAL=12

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

# Frontend Configuration
# Copy this to frontend/.env for frontend development
VITE_API_URL=http://localhost:8000
